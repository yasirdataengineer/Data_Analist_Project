# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# URL HTTPS publik tempat server.js di-deploy (dipakai bot.js untuk tombol Mini App)
WEBAPP_URL=https://hub.example.com
# Chat/grup tujuan notifikasi (kirim /id ke bot untuk melihatnya). Kosongkan untuk mematikan.
TELEGRAM_NOTIFY_CHAT_ID=
# ID Telegram admin (pisahkan koma) yang boleh menyetujui lembur & update semua proyek
ADMIN_TELEGRAM_IDS=
# String acak panjang untuk menandatangani cookie sesi
SESSION_SECRET=
PORT=3000
APP_TZ=Asia/Jakarta
# 1 = aktifkan form login tanpa Telegram (HANYA untuk development)
DEV_LOGIN=0
