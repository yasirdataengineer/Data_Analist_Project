# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Username bot tanpa @ (opsional; dipakai untuk link "Masuk dengan Telegram")
TELEGRAM_BOT_USERNAME=
# URL HTTPS publik tempat server.js di-deploy (dipakai bot.js untuk tombol Mini App)
WEBAPP_URL=https://hub.example.com
# Opsional: alamat server yang dihubungi bot.js untuk konfirmasi login, jika satu mesin (mis. http://localhost:3000)
APP_INTERNAL_URL=
# Chat/grup tujuan notifikasi (kirim /id ke bot untuk melihatnya). Kosongkan untuk mematikan.
TELEGRAM_NOTIFY_CHAT_ID=
# ID Telegram PEMILIK (pisahkan koma). Pemilik selalu aktif dan memberi akses ke pengguna lain
# lewat menu User Admin / Management. Kirim /id ke bot untuk melihat ID Anda.
OWNER_TELEGRAM_IDS=
# String acak panjang untuk menandatangani cookie sesi
SESSION_SECRET=

# --- WhatsApp Business Platform (Cloud API), opsional ---
# Token akses permanen (System User) dan Phone Number ID dari Meta App > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nomor WhatsApp bisnis (format 62…), dipakai untuk link wa.me "Masuk dengan WhatsApp"
WHATSAPP_BUSINESS_NUMBER=
# App Secret (Meta App > Settings > Basic) untuk memverifikasi webhook
WHATSAPP_APP_SECRET=
# String bebas, sama dengan "Verify token" saat mendaftarkan webhook di Meta
WHATSAPP_VERIFY_TOKEN=
# Template notifikasi yang sudah disetujui Meta (lihat README)
WHATSAPP_TEMPLATE_NOTIFY=onehub_notifikasi
WHATSAPP_TEMPLATE_LANG=id
WHATSAPP_API_VERSION=v22.0
# Nomor WhatsApp pemilik (opsional, pisahkan koma); otomatis jadi Pemilik saat masuk lewat WhatsApp
OWNER_WHATSAPP_NUMBERS=
PORT=3000
APP_TZ=Asia/Jakarta
# 1 = aktifkan form login tanpa Telegram (HANYA untuk development)
DEV_LOGIN=0
