<%- include('../partials/head', { title: 'Persetujuan lembur', back: '/payroll/rekap' }) %>
<%- include('../partials/pagehead', { back: '/payroll/rekap', eyebrow: 'Sistem Payroll', heading: 'Persetujuan lembur', sub: 'Lembur yang disetujui otomatis masuk slip gaji bulan tersebut.' }) %>
<% const label = { pending: 'Menunggu', approved: 'Disetujui', rejected: 'Ditolak' }; %>
<% if (!pending.length) { %><div class="card empty">Tidak ada pengajuan lembur yang menunggu.</div><% } %>
<% pending.forEach(o => { %>
  <div class="card">
    <div class="row"><b><%= o.userName %></b><span class="muted"><%= d.formatDate(o.date) %> · <%= o.start %>–<%= o.end %> (<%= (o.minutes / 60).toFixed(1) %> jam)</span></div>
    <p><%= o.reason %></p>
    <div class="actions">
      <form method="post" action="/payroll/lembur/<%= o.id %>/approve"><button class="btn">Setujui</button></form>
      <form method="post" action="/payroll/lembur/<%= o.id %>/reject"><button class="btn btn-ghost">Tolak</button></form>
    </div>
  </div>
<% }) %>
<% if (recent.length) { %>
<h3 class="section">Terakhir diproses</h3>
<% recent.forEach(o => { %>
  <div class="card compact">
    <div class="row"><b><%= o.userName %> · <%= d.formatDate(o.date) %> <%= o.start %>–<%= o.end %></b><span class="status status-<%= o.status %>"><%= label[o.status] %></span></div>
  </div>
<% }) %>
<% } %>
<%- include('../partials/foot') %>
