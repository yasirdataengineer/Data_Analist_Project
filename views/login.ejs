<%- include('partials/head', { title: 'Masuk', user: null }) %>
<p class="eyebrow">TJP / EJS</p>
<h1 class="display">Satu pintu untuk pekerjaan Anda.</h1>
<p class="lead" id="login-status">Menghubungkan akun Telegram…</p>

<% if (botLogin) { %>
<div class="card" id="bot-login" hidden>
  <h2>Masuk dengan Telegram</h2>
  <p class="muted">Kami akan mengirim konfirmasi ke chat bot One Hub di Telegram Anda. Tidak perlu password.</p>

  <div data-step="start">
    <button class="btn btn-block" type="button" id="bot-start">Masuk dengan Telegram</button>
  </div>

  <div data-step="wait" hidden>
    <p class="muted small">Kode di layar ini:</p>
    <div class="login-code" id="bot-code">----</div>
    <a class="btn btn-block" id="bot-open" href="#" target="_blank" rel="noopener">Buka Telegram</a>
    <p class="muted small">Di Telegram, tekan <b>Start</b>, pastikan kodenya sama, lalu tekan <b>"Ya, ini saya"</b>. Halaman ini akan masuk otomatis.</p>
    <p class="muted small" id="bot-timer"></p>
  </div>

  <div data-step="done" hidden>
    <p id="bot-message"></p>
    <button class="btn btn-ghost" type="button" id="bot-retry">Coba lagi</button>
  </div>
</div>
<% } else { %>
<div class="card" id="not-telegram" hidden>
  <h2>Buka lewat Telegram</h2>
  <p>Aplikasi ini berjalan sebagai Mini App. Buka bot TJP-EJS di Telegram lalu tekan tombol <b>One Hub</b>.</p>
</div>
<% } %>

<% if (devLogin) { %>
<form class="card" method="post" action="/auth/dev">
  <h2>Login development</h2>
  <label>Nama<input name="name" value="Pak yasir"></label>
  <label>ID Telegram<input name="id" value="dev-1"></label>
  <label>Peran (dev)
    <select name="role">
      <option value="">— dari data / menunggu akses —</option>
      <% Object.entries(ROLES).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %>
    </select>
  </label>
  <button class="btn">Masuk</button>
</form>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const tg = window.Telegram && Telegram.WebApp;
    const status = document.getElementById('login-status');

    // Inside Telegram: log in silently with initData.
    if (tg && tg.initData) {
      const res = await fetch('/auth/telegram', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ initData: tg.initData }),
      });
      if (res.ok) location.replace('/');
      else status.textContent = 'Verifikasi Telegram gagal. Tutup lalu buka ulang aplikasi.';
      return;
    }

    const box = document.getElementById('bot-login');
    if (!box) {
      status.textContent = 'Tidak terdeteksi di dalam Telegram.';
      document.getElementById('not-telegram').hidden = false;
      return;
    }

    // Outside Telegram (installed app / browser): confirm the login through the bot.
    status.textContent = 'Masuk memakai akun Telegram Anda.';
    box.hidden = false;
    const step = (name) => box.querySelectorAll('[data-step]').forEach((el) => { el.hidden = el.dataset.step !== name; });
    const timer = document.getElementById('bot-timer');
    let poll = null, countdown = null, deadline = 0;

    const stop = () => { clearInterval(poll); clearInterval(countdown); poll = countdown = null; };
    const finish = (text) => { stop(); document.getElementById('bot-message').textContent = text; step('done'); };

    const check = async () => {
      try {
        const res = await fetch('/auth/bot/status', { cache: 'no-store' });
        const { status: s } = await res.json();
        if (s === 'confirmed') { stop(); location.replace('/'); }
        else if (s === 'denied') finish('Login ditolak dari Telegram.');
        else if (s === 'expired') finish('Waktu login habis. Silakan coba lagi.');
      } catch (e) { /* offline for a moment; keep polling */ }
    };

    const start = async () => {
      const btn = document.getElementById('bot-start');
      btn.disabled = true;
      try {
        const res = await fetch('/auth/bot/start', { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal memulai login.');
        document.getElementById('bot-code').textContent = data.code;
        document.getElementById('bot-open').href = data.link;
        step('wait');
        deadline = Date.now() + data.expiresIn * 1000;
        const tick = () => {
          const left = Math.max(0, Math.round((deadline - Date.now()) / 1000));
          timer.textContent = `Berlaku ${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
        };
        tick();
        countdown = setInterval(tick, 1000);
        poll = setInterval(check, 2000);
      } catch (e) {
        finish(e.message);
      } finally {
        btn.disabled = false;
      }
    };

    document.getElementById('bot-start').addEventListener('click', start);
    document.getElementById('bot-retry').addEventListener('click', () => { stop(); step('start'); });
    // Coming back from the Telegram app: check right away instead of waiting for the next tick.
    document.addEventListener('visibilitychange', () => { if (!document.hidden && poll) check(); });
  });
</script>
<%- include('partials/foot') %>
