<%- include('partials/head', { title: 'Masuk', user: null }) %>
<p class="eyebrow">TJP / EJS</p>
<h1 class="display">Satu pintu untuk pekerjaan Anda.</h1>
<p class="lead" id="login-status">Menghubungkan akun…</p>

<div id="chat-logins" hidden>
  <% if (botLogin) { %>
    <%- include('partials/chat-login', {
      channel: 'telegram', purpose: 'login',
      title: 'Masuk dengan Telegram',
      intro: 'Konfirmasi dikirim ke chat bot One Hub di Telegram Anda. Tidak perlu password.',
      startLabel: 'Masuk dengan Telegram', openLabel: 'Buka Telegram',
      steps: 'Di Telegram, tekan <b>Start</b>, pastikan kodenya sama, lalu tekan <b>"Ya, ini saya"</b>. Halaman ini akan masuk otomatis.'
    }) %>
  <% } %>
  <% if (waLogin) { %>
    <%- include('partials/chat-login', {
      channel: 'whatsapp', purpose: 'login',
      title: 'Masuk dengan WhatsApp',
      intro: 'Kirim pesan ke nomor WhatsApp One Hub, lalu konfirmasi. Tidak perlu password.',
      startLabel: 'Masuk dengan WhatsApp', openLabel: 'Buka WhatsApp & kirim pesan',
      steps: 'Di WhatsApp, kirim pesan <b>MASUK …</b> yang sudah terisi, pastikan kodenya sama, lalu tekan <b>"Ya, ini saya"</b>. Halaman ini akan masuk otomatis.'
    }) %>
  <% } %>
  <% if (!botLogin && !waLogin) { %>
  <div class="card">
    <h2>Buka lewat Telegram</h2>
    <p>Aplikasi ini berjalan sebagai Mini App. Buka bot TJP-EJS di Telegram lalu tekan tombol <b>One Hub</b>.</p>
  </div>
  <% } %>
</div>

<% if (devLogin) { %>
<form class="card" method="post" action="/auth/dev">
  <h2>Login development</h2>
  <label>Nama<input name="name" value="Pak yasir"></label>
  <label>ID Telegram<input name="id" value="dev-1"></label>
  <label>Peran (dev)
    <select name="role">
      <option value="">— dari data / menunggu akses —</option>
      <% Object.entries(ROLES).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %>
    </select>
  </label>
  <button class="btn">Masuk</button>
</form>
<% } %>

<script src="/public/chat-login.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const tg = window.Telegram && Telegram.WebApp;
    const status = document.getElementById('login-status');

    // Inside Telegram: log in silently with initData.
    if (tg && tg.initData) {
      const res = await fetch('/auth/telegram', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ initData: tg.initData }),
      });
      if (res.ok) location.replace('/');
      else status.textContent = 'Verifikasi Telegram gagal. Tutup lalu buka ulang aplikasi.';
      return;
    }

    // Outside Telegram (installed app / browser): confirm through a chat app.
    status.textContent = 'Masuk memakai akun Telegram atau WhatsApp Anda.';
    document.getElementById('chat-logins').hidden = false;
  });
</script>
<%- include('partials/foot') %>
