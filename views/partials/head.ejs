<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= appName %></title>
  <link rel="stylesheet" href="/public/style.css">
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <script src="/public/app.js" defer></script>
</head>
<body data-back="<%= typeof back !== 'undefined' ? back : '' %>">
  <header class="topbar">
    <a href="/" class="brand">
      <svg viewBox="0 0 24 24" class="ico" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>TJP-EJS <b>One Hub</b></span>
    </a>
    <% if (user) { %><span class="who"><%= user.name %></span><% } %>
  </header>
  <main class="wrap">
    <% if (flash) { %><div class="flash"><%= flash %></div><% } %>
