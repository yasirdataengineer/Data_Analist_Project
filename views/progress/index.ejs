<%- include('../partials/head', { title: 'Monitoring Progres', back: '/' }) %>
<%- include('../partials/pagehead', { back: '/', eyebrow: 'TJP / EJS', heading: 'Evaluasi & penugasan pekerjaan', sub: 'Isi persentase, hasil atau kendala, dan foto terbaru.' }) %>

<a class="btn btn-outline" href="/progres?f=<%= filter %><%= pic ? '&pic=' + pic : '' %>">Muat ulang</a>

<% if (can('progress.assign')) { %>
<div class="card callout">
  <p class="muted">Evaluasi hasil, periksa foto, lalu tentukan Open atau Closed untuk pekerjaan.</p>
  <a class="btn btn-block" href="/progres/baru">Tambah penugasan</a>
</div>
<% } %>

<a class="card stat-row" href="/progres?f=open"><span>Perlu progres</span><b><%= stats.needProgress %></b></a>
<a class="card stat-row" href="/progres?f=done"><span>100% / ditutup</span><b><%= stats.done %></b></a>
<div class="card stat-row"><span>PIC dalam daftar</span><b><%= stats.pics %></b></div>

<form class="search" method="get">
  <select name="f" onchange="this.form.submit()">
    <option value="open" <%= filter === 'open' ? 'selected' : '' %>>Perlu progres</option>
    <option value="done" <%= filter === 'done' ? 'selected' : '' %>>100% / ditutup</option>
    <option value="all" <%= filter === 'all' ? 'selected' : '' %>>Semua</option>
  </select>
  <% if (can('progress.viewAll')) { %>
  <select name="pic" onchange="this.form.submit()">
    <option value="">Semua PIC</option>
    <% pics.forEach(p => { %><option value="<%= p.id %>" <%= pic === p.id ? 'selected' : '' %>><%= p.name %></option><% }) %>
  </select>
  <% } %>
</form>

<% if (!rows.length) { %><div class="card empty">Tidak ada pekerjaan di daftar ini.</div><% } %>
<% rows.forEach(a => { %>
  <a class="card card-link project" href="/progres/<%= a.id %>">
    <% if (a.latestPhoto) { %><img class="thumb" src="<%= a.latestPhoto %>" alt="" loading="lazy"><% } %>
    <div class="grow">
      <div class="row">
        <span class="tag"><%= a.projectName || 'Umum' %></span>
        <span class="status <%= a.status === 'closed' ? 'status-closed' : 'status-open' %>"><%= a.status === 'closed' ? 'Closed' : 'Open' %></span>
      </div>
      <h2><%= a.title %></h2>
      <p class="muted">PIC <%= a.picName %><%= a.dueDate ? ' · target ' + d.formatDate(a.dueDate) : '' %></p>
      <div class="bar"><span style="width: <%= a.progress %>%"></span></div>
      <p class="row"><b><%= a.progress %>%</b><span class="muted small"><%= a.lastUpdate ? 'Update ' + d.formatDateTime(a.lastUpdate.createdAt) : 'Belum ada update' %></span></p>
    </div>
  </a>
<% }) %>
<%- include('../partials/foot') %>
