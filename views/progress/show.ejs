<%- include('../partials/head', { title: a.title, back: '/progres' }) %>
<%- include('../partials/pagehead', { back: '/progres', eyebrow: a.projectName || 'Penugasan', heading: a.title, sub: 'PIC ' + a.picName + (a.dueDate ? ' · Target ' + d.formatDate(a.dueDate) : '') }) %>

<div class="card">
  <div class="row"><span class="status <%= a.status === 'closed' ? 'status-closed' : 'status-open' %>"><%= a.status === 'closed' ? 'Closed' : 'Open' %></span><b class="big"><%= a.progress %>%</b></div>
  <div class="bar bar-lg"><span style="width: <%= a.progress %>%"></span></div>
  <% if (a.description) { %><p class="note"><%= a.description %></p><% } %>
</div>

<% if (photos.length) { %>
<h3 class="section">Foto terbaru</h3>
<div class="gallery">
  <% photos.slice(0, 9).forEach(ph => { %><a href="<%= ph.src %>" target="_blank"><img src="<%= ph.src %>" alt="Foto <%= d.formatDate(ph.at) %>" loading="lazy"></a><% }) %>
</div>
<% } %>

<% if (a.picId === user.id && a.status !== 'closed') { %>
<h3 class="section">Isi progres</h3>
<form class="card form" method="post" action="/progres/<%= a.id %>/update" enctype="multipart/form-data">
  <label>Persentase: <output id="pv"><%= a.progress %></output>%
    <input type="range" name="progress" min="0" max="100" step="5" value="<%= a.progress %>" oninput="pv.value=this.value">
  </label>
  <label>Hasil<textarea name="result" rows="3" placeholder="Pekerjaan yang sudah selesai"></textarea></label>
  <label>Kendala<textarea name="issue" rows="2" placeholder="Material belum datang, akses lokasi, dll."></textarea></label>
  <label>Foto terbaru (maks. 6)<input type="file" name="photos" accept="image/*" multiple capture="environment"></label>
  <button class="btn">Kirim progres</button>
</form>
<% } %>

<% if (can('progress.assign')) { %>
<h3 class="section">Evaluasi</h3>
<form class="card form" method="post" action="/progres/<%= a.id %>/evaluasi">
  <label>Catatan evaluasi<textarea name="note" rows="2"></textarea></label>
  <div class="actions">
    <button class="btn" name="status" value="closed">Closed</button>
    <button class="btn btn-ghost" name="status" value="open">Open (lanjutkan)</button>
  </div>
</form>
<% } %>

<h3 class="section">Riwayat update</h3>
<% if (!history.length) { %><div class="card empty">Belum ada update.</div><% } %>
<ol class="timeline">
  <% history.forEach(h => { %>
    <li class="<%= h.kind === 'evaluation' ? 'eval' : '' %>">
      <div class="row"><b><%= h.authorName %></b><span class="muted small"><%= d.formatDateTime(h.createdAt) %></span></div>
      <% if (h.kind === 'evaluation') { %>
        <p><span class="status <%= h.status === 'closed' ? 'status-closed' : 'status-open' %>">Evaluasi: <%= h.status === 'closed' ? 'Closed' : 'Open' %></span></p>
        <% if (h.note) { %><p><%= h.note %></p><% } %>
      <% } else { %>
        <p><span class="tag"><%= h.from %>% → <%= h.to %>%</span></p>
        <% if (h.result) { %><p><b>Hasil:</b> <%= h.result %></p><% } %>
        <% if (h.issue) { %><p><b>Kendala:</b> <%= h.issue %></p><% } %>
        <% if (h.photos && h.photos.length) { %><div class="gallery small"><% h.photos.forEach(src => { %><a href="<%= src %>" target="_blank"><img src="<%= src %>" alt="" loading="lazy"></a><% }) %></div><% } %>
      <% } %>
    </li>
  <% }) %>
</ol>
<%- include('../partials/foot') %>
