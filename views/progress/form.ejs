<%- include('../partials/head', { title: 'Proyek baru', back: '/progres' }) %>
<%- include('../partials/pagehead', { back: '/progres', eyebrow: 'Monitoring Progres', heading: 'Proyek baru' }) %>
<form class="card form" method="post" action="/progres">
  <label>Kode proyek<input name="code" placeholder="mis. C006"></label>
  <label>Nama proyek *<input name="name" required placeholder="mis. UPS MCS Bitung"></label>
  <label>Lokasi<input name="location"></label>
  <label>PIC
    <select name="picId">
      <% users.forEach(u => { %><option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.name %></option><% }) %>
    </select>
  </label>
  <label>Target selesai<input type="date" name="target"></label>
  <button class="btn">Simpan proyek</button>
</form>
<%- include('../partials/foot') %>
