<%- include('../partials/head', { title: 'Tambah penugasan', back: '/progres' }) %>
<%- include('../partials/pagehead', { back: '/progres', eyebrow: 'Monitoring Progres', heading: 'Tambah penugasan' }) %>
<form class="card form" method="post" action="/progres">
  <label>Pekerjaan *<input name="title" required placeholder="mis. Instalasi battery rack UPS"></label>
  <label>Project
    <select name="projectId">
      <option value="">— Umum —</option>
      <% projects.forEach(p => { %><option value="<%= p.id %>"><%= p.code %> — <%= p.name %></option><% }) %>
    </select>
  </label>
  <label>PIC *
    <select name="picId" required>
      <% people.forEach(u => { %><option value="<%= u.id %>"><%= u.name %><%= u.company ? ' · ' + u.company : '' %></option><% }) %>
    </select>
  </label>
  <label>Target selesai<input type="date" name="dueDate"></label>
  <label>Detail / instruksi<textarea name="description" rows="4"></textarea></label>
  <button class="btn">Simpan penugasan</button>
</form>
<%- include('../partials/foot') %>
